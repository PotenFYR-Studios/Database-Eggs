# Fast mirror of the production image layout for launcher behavior tests.
# Same paths, same non-root uid (988), same signal contract - without the
# multi-minute build of the full multi-database image. Redis boots in
# milliseconds, making it the lifecycle-test engine.
FROM debian:bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    USER=container \
    HOME=/home/container

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates curl wget git jq procps xz-utils unzip tar \
        redis-server python3 \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd -g 988 container 2>/dev/null || true \
    && useradd -d /home/container -m -u 988 -g 988 container 2>/dev/null || true \
    && mkdir -p /opt/potenfyr /home/container /mnt/server /tmp \
    && chmod -R 777 /opt/potenfyr /home/container /mnt/server /tmp \
    && chown -R 988:988 /opt/potenfyr

COPY entrypoint.sh /entrypoint.sh
COPY entrypoint.sh /usr/local/bin/entrypoint.sh
COPY run.sh /run.sh
COPY run.sh /usr/local/bin/run.sh
COPY scripts/ /usr/local/bin/
COPY tests/t5b-driver.py /t5b-driver.py

RUN sed -i 's/\r$//' /entrypoint.sh /run.sh /usr/local/bin/*.sh /t5b-driver.py \
    && chmod +x /entrypoint.sh /run.sh /usr/local/bin/*.sh

USER container
ENV USER=container HOME=/home/container
WORKDIR /home/container

STOPSIGNAL SIGTERM
CMD ["/bin/bash", "/entrypoint.sh"]
